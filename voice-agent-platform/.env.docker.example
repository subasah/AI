# Copy to .env.docker and adjust before `docker compose up`
#   cp .env.docker.example .env.docker

# --- Public entry ---
HTTP_PORT=80
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1
ADMIN_ACCESS_TOKEN=dev-admin-token

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_DATABASE=aethervoice
MYSQL_USER=aethervoice
MYSQL_PASSWORD=aethervoice_pass_change_me

# --- Voice / telephony (fill when ready) ---
GOOGLE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DAILY_API_KEY=

# Classic cascade (only if pipeline_mode=classic)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
