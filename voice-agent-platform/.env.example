# Voice Agent Platform — fill in after you purchase / create accounts.
# Never commit real secrets.

# --- Default pipeline: Gemini Live Flash (speech → speech) ---
# One key replaces Deepgram + OpenAI + Cartesia for voice I/O.
GOOGLE_API_KEY=
# Optional model override is set per-deployment (default: gemini-2.5-flash-native-audio)

# --- Classic cascade (only if pipeline_mode=classic) ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional alternatives
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=

# --- Realtime transport ---
DAILY_API_KEY=
# DAILY_ROOM_URL=

# --- Telephony (inbound / outbound PSTN) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=http://localhost:8080

# --- Customer service secrets (per deployment; use vault in prod) ---
CUSTOMER_DMS_API_KEY=
CUSTOMER_LOS_API_KEY=
# MCP_AUTH_TOKEN=

# --- App ---
HOST=0.0.0.0
PORT=8080
RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Simple gate for admin UI (replace with real auth later)
ADMIN_ACCESS_TOKEN=dev-admin-token
